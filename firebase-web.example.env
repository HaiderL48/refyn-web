# Copy to .env.local (gitignored). Only NEXT_PUBLIC_* vars belong here — never API secrets.

# api_refyn base URL (no trailing slash). Browser calls are proxied via /api/refyn/*.
NEXT_PUBLIC_API_REFYN_URL=https://refynai.haidelimdi.workers.dev

# Canonical public URL for sitemap + Open Graph (required in production)
# NEXT_PUBLIC_SITE_URL=https://refynai.com

# Optional
# NEXT_PUBLIC_APP_VERSION=0.1.0
# NEXT_PUBLIC_REFYN_DESKTOP_URL=renfy://auth-complete
